<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Memorise — Spaced Repetition Study Calendar</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              500: '#2563eb',
              600: '#1d4ed8',
              700: '#1e40af',
            }
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    /* Custom scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(156, 163, 175, 0.4);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(156, 163, 175, 0.7);
    }
  </style>
</head>
<body class="bg-stone-50 dark:bg-stone-950 text-stone-900 dark:text-stone-100 min-h-screen flex flex-col transition-colors duration-200">

  <!-- TOP NAVIGATION BAR -->
  <header class="border-b border-stone-200 dark:border-stone-800 bg-white/80 dark:bg-stone-900/80 backdrop-blur sticky top-0 z-30 px-4 sm:px-6 py-3">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
      
      <!-- Brand & Stats -->
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 text-white flex items-center justify-center font-bold text-lg shadow-sm">
          🧠
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold tracking-tight flex items-center gap-2">
            Memorise
            <span class="text-xs px-2 py-0.5 rounded-full font-medium bg-brand-50 text-brand-600 dark:bg-brand-950 dark:text-brand-400 border border-brand-200 dark:border-brand-900">Spaced Repetition</span>
          </h1>
          <p class="text-xs text-stone-500 dark:text-stone-400 hidden sm:block">Master anything with scientifically spaced reviews</p>
        </div>
      </div>

      <!-- Action Utilities -->
      <div class="flex items-center gap-2">
        <!-- All Topics Library Button -->
        <button onclick="openModal('topicsLibraryModal')" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-stone-200 dark:border-stone-800 hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-700 dark:text-stone-200 text-xs sm:text-sm font-semibold transition active:scale-95">
          <svg class="w-4 h-4 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          <span>All Topics</span>
        </button>

        <!-- New Topic Button -->
        <button onclick="openModal('addTopicModal')" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-white dark:bg-stone-100 dark:hover:bg-white dark:text-stone-900 text-xs sm:text-sm font-semibold shadow-sm transition active:scale-95">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>New Topic</span>
        </button>

        <!-- Notification Toggle Button -->
        <button id="notifyBtn" onclick="toggleNotifications()" title="Notifications settings" class="p-2 rounded-lg border border-stone-200 dark:border-stone-800 hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-600 dark:text-stone-300 transition">
          <svg id="bellIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
        </button>

        <!-- Backup Data Modal Trigger -->
        <button onclick="openModal('backupModal')" title="Backup & Restore Data" class="p-2 rounded-lg border border-stone-200 dark:border-stone-800 hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-600 dark:text-stone-300 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
        </button>

        <!-- Dark/Light Mode Switcher -->
        <button onclick="toggleDarkMode()" title="Toggle Theme" class="p-2 rounded-lg border border-stone-200 dark:border-stone-800 hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-600 dark:text-stone-300 transition">
          <svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </button>
      </div>

    </div>
  </header>

  <!-- NOTIFICATION BANNER (When Due Today) -->
  <div id="dueNoticeBanner" class="hidden bg-amber-50 dark:bg-amber-950/60 border-b border-amber-200 dark:border-amber-900/60 px-4 py-2.5 text-xs sm:text-sm text-amber-800 dark:text-amber-300">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
        </span>
        <span id="dueNoticeText" class="font-medium">You have reviews due today!</span>
      </div>
      <button onclick="scrollToDueSection()" class="underline font-semibold hover:text-amber-900 dark:hover:text-amber-200">
        Review Now &darr;
      </button>
    </div>
  </div>

  <!-- MAIN APPLICATION CONTENT -->
  <main class="max-w-7xl mx-auto w-full px-4 sm:px-6 py-6 flex-1 flex flex-col gap-6">

    <!-- METRICS STRIP -->
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      <div class="bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-xl p-3.5 sm:p-4 shadow-sm cursor-pointer hover:border-brand-300 transition" onclick="scrollToDueSection()">
        <div class="text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">Due Today</div>
        <div class="text-2xl font-bold mt-1 text-brand-600 dark:text-brand-400" id="statDueToday">0</div>
        <div class="text-[11px] text-stone-400 mt-0.5">Scheduled for today &darr;</div>
      </div>
      <div class="bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-xl p-3.5 sm:p-4 shadow-sm cursor-pointer hover:border-brand-300 transition" onclick="openModal('topicsLibraryModal')">
        <div class="flex items-center justify-between">
          <div class="text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">Total Topics</div>
          <span class="text-[10px] text-brand-600 dark:text-brand-400 font-semibold underline">Manage</span>
        </div>
        <div class="text-2xl font-bold mt-1 text-stone-800 dark:text-stone-200" id="statTotalTopics">0</div>
        <div class="text-[11px] text-stone-400 mt-0.5">Click to view all &rarr;</div>
      </div>
      <div class="bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-xl p-3.5 sm:p-4 shadow-sm">
        <div class="text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">Total Topics</div>
        <div class="text-2xl font-bold mt-1 text-stone-800 dark:text-stone-200" id="statTotalTopics">0</div>
        <div class="text-[11px] text-stone-400 mt-0.5">Active curriculum</div>
      </div>
      <div class="bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-xl p-3.5 sm:p-4 shadow-sm">
        <div class="text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">Completed Reviews</div>
        <div class="text-2xl font-bold mt-1 text-emerald-600 dark:text-emerald-400" id="statCompletedReviews">0</div>
        <div class="text-[11px] text-stone-400 mt-0.5">Total recall sessions</div>
      </div>
      <div class="bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-xl p-3.5 sm:p-4 shadow-sm">
        <div class="text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">Retention Streak</div>
        <div class="text-2xl font-bold mt-1 text-amber-500 dark:text-amber-400" id="statStreak">0 days 🔥</div>
        <div class="text-[11px] text-stone-400 mt-0.5">Consistent reviews</div>
      </div>
    </section>

    <!-- TWO-COLUMN WORKSPACE: TODAY'S FOCUS & CALENDAR -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- LEFT: TODAY'S REVIEWS FOCUS PANEL (5 Cols on LG) -->
      <section id="dueSection" class="lg:col-span-5 flex flex-col gap-4">
        <div class="bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-2xl p-5 shadow-sm">
          
          <div class="flex items-center justify-between border-b border-stone-100 dark:border-stone-800 pb-3 mb-4">
            <div>
              <h2 class="font-bold text-base tracking-tight flex items-center gap-2">
                <span>🎯 Today's Due Repetitions</span>
              </h2>
              <p class="text-xs text-stone-500 dark:text-stone-400" id="todayHumanDate">Loading date...</p>
            </div>
            <span id="dueBadgeCount" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300">
              0 due
            </span>
          </div>

          <!-- Empty State -->
          <div id="emptyDueContainer" class="hidden py-10 flex flex-col items-center justify-center text-center">
            <div class="w-12 h-12 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl mb-3">
              ✓
            </div>
            <h3 class="font-semibold text-sm">All caught up for today!</h3>
            <p class="text-xs text-stone-500 dark:text-stone-400 max-w-xs mt-1">
              Your brain has retained everything due today. Add a new topic or inspect past and upcoming days on the calendar.
            </p>
            <button onclick="openModal('addTopicModal')" class="mt-4 text-xs font-medium text-brand-600 dark:text-brand-400 hover:underline">
              + Review a new topic today
            </button>
          </div>

          <!-- Due List Container -->
          <div id="dueListContainer" class="flex flex-col gap-3 max-h-[600px] overflow-y-auto pr-1">
            <!-- Injected dynamically via JS -->
          </div>

        </div>

        <!-- QUICK INTERVAL REFERENCE CHEAT SHEET -->
        <div class="bg-stone-100/60 dark:bg-stone-900/60 border border-stone-200 dark:border-stone-800 rounded-xl p-4 text-xs">
          <div class="font-semibold text-stone-700 dark:text-stone-300 mb-2 flex items-center justify-between">
            <span>Interval Curve Presets</span>
            <span class="text-[10px] text-stone-500 uppercase tracking-wider">Ebbinghaus Curve</span>
          </div>
          <div class="flex flex-wrap gap-1.5 text-[11px]">
            <span class="px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900 font-mono">Stage 1: +1d</span>
            <span class="px-2 py-0.5 rounded bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-900 font-mono">Stage 2: +3d</span>
            <span class="px-2 py-0.5 rounded bg-violet-100 dark:bg-violet-950 text-violet-700 dark:text-violet-300 border border-violet-200 dark:border-violet-900 font-mono">Stage 3: +7d</span>
            <span class="px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900 font-mono">Stage 4: +14d</span>
            <span class="px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900 font-mono">Stage 5: +30d</span>
            <span class="px-2 py-0.5 rounded bg-teal-100 dark:bg-teal-950 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-900 font-mono">Stage 6: +60d</span>
          </div>
        </div>
      </section>

      <!-- RIGHT: INTERACTIVE MONTHLY CALENDAR (7 Cols on LG) -->
      <section class="lg:col-span-7 flex flex-col gap-4">
        <div class="bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-2xl p-5 shadow-sm">
          
          <!-- Calendar Header Controls -->
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <h2 id="calendarMonthYear" class="font-bold text-base sm:text-lg tracking-tight">Month Year</h2>
              <button onclick="goToCurrentMonth()" class="text-xs px-2 py-0.5 rounded-md border border-stone-200 dark:border-stone-800 hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-600 dark:text-stone-300">
                Today
              </button>
            </div>
            
            <div class="flex items-center gap-1">
              <button onclick="changeMonth(-1)" class="p-1.5 rounded-lg border border-stone-200 dark:border-stone-800 hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-600 dark:text-stone-300 transition" title="Previous Month">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <button onclick="changeMonth(1)" class="p-1.5 rounded-lg border border-stone-200 dark:border-stone-800 hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-600 dark:text-stone-300 transition" title="Next Month">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>
          </div>

          <!-- Weekday Labels -->
          <div class="grid grid-cols-7 gap-1 text-center font-medium text-xs text-stone-400 dark:text-stone-500 mb-1">
            <div>Sun</div>
            <div>Mon</div>
            <div>Tue</div>
            <div>Wed</div>
            <div>Thu</div>
            <div>Fri</div>
            <div>Sat</div>
          </div>

          <!-- Calendar Grid Cells -->
          <div id="calendarGrid" class="grid grid-cols-7 gap-1">
            <!-- Calendar Days will be generated by JS -->
          </div>

          <!-- Calendar Legend & Filter Summary -->
          <div class="mt-4 pt-3 border-t border-stone-100 dark:border-stone-800 flex flex-wrap items-center justify-between gap-3 text-xs text-stone-500 dark:text-stone-400">
            <div class="flex items-center gap-3">
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-brand-500 inline-block"></span> Scheduled</span>
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> Done</span>
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span> Overdue</span>
            </div>
            <span>Click any day to inspect</span>
          </div>

        </div>

        <!-- SELECTED DATE INSPECTOR DRAWER -->
        <div id="inspectorPanel" class="bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-2xl p-5 shadow-sm scroll-mt-20">
          <div class="flex items-center justify-between border-b border-stone-100 dark:border-stone-800 pb-3 mb-3">
            <div>
              <h3 class="font-bold text-sm sm:text-base flex items-center gap-2">
                <span>🗓️ Reviews on Selected Date:</span>
                <span id="inspectorDateLabel" class="text-brand-600 dark:text-brand-400 font-semibold">Today</span>
              </h3>
              <p class="text-[11px] text-stone-400" id="inspectorSubtitle">Click any date on the calendar to switch inspection.</p>
            </div>
            <button onclick="scheduleTopicForSelectedDate()" class="text-xs px-2.5 py-1.5 rounded-lg bg-brand-50 hover:bg-brand-100 dark:bg-brand-950/60 dark:hover:bg-brand-900/60 text-brand-600 dark:text-brand-300 border border-brand-200 dark:border-brand-800 transition font-medium">
              + New Topic Here
            </button>
          </div>

          <div id="inspectorItemsList" class="flex flex-col gap-2 max-h-80 overflow-y-auto pr-1">
            <!-- Day items rendered by JS -->
          </div>
        </div>

      </section>

    </div>

  </main>

  <!-- MODAL: ALL TOPICS / MASTER DECK LIBRARY -->
  <div id="topicsLibraryModal" class="fixed inset-0 z-50 bg-stone-900/40 backdrop-blur-sm hidden items-center justify-center p-3 sm:p-4">
    <div class="bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-2xl max-w-4xl w-full p-5 sm:p-6 shadow-2xl flex flex-col max-h-[90vh]">
      
      <!-- Header -->
      <div class="flex items-center justify-between border-b border-stone-100 dark:border-stone-800 pb-3 mb-4">
        <div>
          <h3 class="font-bold text-lg flex items-center gap-2">
            <span>📚 All Topics Deck</span>
            <span id="libraryTotalBadge" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300">0 Topics</span>
          </h3>
          <p class="text-xs text-stone-400">Search, edit, inspect review progress, or delete topics from your curriculum.</p>
        </div>
        <button onclick="closeModal('topicsLibraryModal')" class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 text-2xl font-light">&times;</button>
      </div>

      <!-- Filters & Search Toolbar -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mb-4">
        <div class="relative flex-1">
          <input type="text" id="librarySearchInput" oninput="renderTopicsLibrary()" placeholder="Search by topic name, formula, or notes..." class="w-full text-xs sm:text-sm pl-8 pr-3 py-2 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <svg class="w-4 h-4 text-stone-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>

        <div class="flex items-center gap-2">
          <select id="libraryCategoryFilter" onchange="renderTopicsLibrary()" class="text-xs py-2 px-2.5 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 focus:outline-none">
            <option value="ALL">All Subjects</option>
          </select>
          <select id="librarySortFilter" onchange="renderTopicsLibrary()" class="text-xs py-2 px-2.5 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 focus:outline-none">
            <option value="newest">Newest First</option>
            <option value="oldest">Oldest First</option>
            <option value="alpha">Alphabetical</option>
          </select>
        </div>
      </div>

      <!-- Topics List Content -->
      <div id="topicsLibraryList" class="flex-1 overflow-y-auto pr-1 flex flex-col gap-2.5 min-h-[250px]">
        <!-- Injected via renderTopicsLibrary() -->
      </div>

    </div>
  </div>

  <!-- MODAL: ADD NEW TOPIC -->
  <div id="addTopicModal" class="fixed inset-0 z-50 bg-stone-900/40 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-lg">Add New Study Topic</h3>
        <button onclick="closeModal('addTopicModal')" class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 text-lg">&times;</button>
      </div>

      <form onsubmit="handleCreateTopic(event)" class="flex flex-col gap-4">
        <div>
          <label class="block text-xs font-semibold text-stone-600 dark:text-stone-300 mb-1">Topic / Concept Name *</label>
          <input type="text" id="topicNameInput" required placeholder="e.g. Nervous System Action Potentials" class="w-full text-sm px-3 py-2 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-stone-600 dark:text-stone-300 mb-1">Subject / Category</label>
            <input type="text" id="topicCategoryInput" placeholder="e.g. Biology, CS, History" class="w-full text-sm px-3 py-2 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-stone-600 dark:text-stone-300 mb-1">Color Tag</label>
            <div class="flex items-center gap-2 pt-1">
              <label class="cursor-pointer"><input type="radio" name="colorTag" value="blue" checked class="sr-only peer"><span class="w-6 h-6 rounded-full bg-blue-500 peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-stone-900 dark:peer-checked:ring-stone-100 inline-block"></span></label>
              <label class="cursor-pointer"><input type="radio" name="colorTag" value="emerald" class="sr-only peer"><span class="w-6 h-6 rounded-full bg-emerald-500 peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-stone-900 dark:peer-checked:ring-stone-100 inline-block"></span></label>
              <label class="cursor-pointer"><input type="radio" name="colorTag" value="purple" class="sr-only peer"><span class="w-6 h-6 rounded-full bg-purple-500 peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-stone-900 dark:peer-checked:ring-stone-100 inline-block"></span></label>
