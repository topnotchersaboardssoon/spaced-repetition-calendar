  <!-- JAVASCRIPT APPLICATION LOGIC -->
  <script>
    /* ==========================================================================
       STORAGE & DATA MODELS
       ========================================================================== */
    const STORAGE_KEY = 'spaced_repetition_study_data_v1';
    const NOTIFY_TIME_KEY = 'spaced_repetition_notify_time_v1';

    // Interval Schedules in days
    const SCHEDULE_PRESETS = {
      standard: [1, 3, 7, 14, 30, 60],
      intensive: [1, 2, 4, 7, 15, 30],
      light: [2, 5, 12, 25, 50]
    };

    let appData = {
      topics: [],
      // review item structure: { id, topicId, dueDate: 'YYYY-MM-DD', intervalIndex: 0, intervalDays: 1, status: 'pending'|'completed', completedAt: null, rating: null }
      reviews: [],
      streakCount: 0,
      lastStreakDate: null
    };

    let currentCalendarDate = new Date();
    let selectedInspectorDate = getTodayKey();

    /* ==========================================================================
       SOUND CHIME (Web Audio API - completely offline without assets)
       ========================================================================== */
    function playChime(type = 'success') {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        
        if (type === 'success') {
          // Cheerful chime: C5 -> E5 -> G5
          const notes = [523.25, 659.25, 783.99];
          notes.forEach((freq, i) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, ctx.currentTime + i * 0.08);
            gain.gain.setValueAtTime(0.001, ctx.currentTime + i * 0.08);
            gain.gain.exponentialRampToValueAtTime(0.2, ctx.currentTime + i * 0.08 + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.08 + 0.35);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(ctx.currentTime + i * 0.08);
            osc.stop(ctx.currentTime + i * 0.08 + 0.36);
          });
        } else if (type === 'bell') {
          // Single focus chime
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(880, ctx.currentTime);
          gain.gain.setValueAtTime(0.25, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.8);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.85);
        }
      } catch (err) {
        console.warn('Audio Context disabled or not supported', err);
      }
    }

    /* ==========================================================================
       DATE HELPERS
       ========================================================================== */
    function getTodayKey() {
      const now = new Date();
      return formatDateKey(now);
    }

    function formatDateKey(dateObj) {
      const y = dateObj.getFullYear();
      const m = String(dateObj.getMonth() + 1).padStart(2, '0');
      const d = String(dateObj.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }

    function parseDateKey(keyStr) {
      const [y, m, d] = keyStr.split('-').map(Number);
      return new Date(y, m - 1, d);
    }

    function addDaysToDateKey(baseKey, days) {
      const d = parseDateKey(baseKey);
      d.setDate(d.getDate() + days);
      return formatDateKey(d);
    }

    function formatHumanReadable(keyStr) {
      const d = parseDateKey(keyStr);
      return d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    }

    /* ==========================================================================
       CORE SPACED REPETITION ENGINE
       ========================================================================== */
    function scheduleTopic(topicName, category, color, startDateKey, presetName, notes) {
      const topicId = 't_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
      const intervals = SCHEDULE_PRESETS[presetName] || SCHEDULE_PRESETS.standard;

      const newTopic = {
        id: topicId,
        name: topicName,
        category: category || 'General',
        color: color || 'blue',
        startDate: startDateKey,
        preset: presetName,
        notes: notes || '',
        createdAt: new Date().toISOString()
      };

      appData.topics.push(newTopic);

      // Generate the spaced repetition intervals
      intervals.forEach((intervalDays, index) => {
        const reviewDueDate = addDaysToDateKey(startDateKey, intervalDays);
        appData.reviews.push({
          id: 'rev_' + Date.now() + '_' + index + '_' + Math.random().toString(36).substr(2, 4),
          topicId: topicId,
          dueDate: reviewDueDate,
          intervalIndex: index + 1,
          intervalDays: intervalDays,
          status: 'pending',
          completedAt: null,
          rating: null
        });
      });

      saveData();
      renderAll();
      playChime('success');
    }

    // Dynamic rating (SM-2 style option: Again / Hard / Good / Easy)
    function completeReviewWithRating(reviewId, rating = 'good') {
      const review = appData.reviews.find(r => r.id === reviewId);
      if (!review) return;

      review.status = 'completed';
      review.completedAt = new Date().toISOString();
      review.rating = rating;

      const today = getTodayKey();
      updateStreak(today);

      // Rescheduling intelligence based on recall rating
      if (rating === 'again') {
        // Needs immediate review tomorrow
        const nextReviewDate = addDaysToDateKey(today, 1);
        appData.reviews.push({
          id: 'rev_' + Date.now() + '_retest',
          topicId: review.topicId,
          dueDate: nextReviewDate,
          intervalIndex: review.intervalIndex,
          intervalDays: 1,
          status: 'pending',
          completedAt: null,
          rating: null
        });
      } else if (rating === 'hard') {
        // Shortened interval (+2 days)
        const nextReviewDate = addDaysToDateKey(today, 2);
        appData.reviews.push({
          id: 'rev_' + Date.now() + '_hard',
          topicId: review.topicId,
          dueDate: nextReviewDate,
          intervalIndex: review.intervalIndex + 1,
          intervalDays: 2,
          status: 'pending',
          completedAt: null,
          rating: null
        });
      }

      saveData();
      renderAll();
      playChime('success');
    }

    function postponeReview(reviewId, days = 1) {
      const review = appData.reviews.find(r => r.id === reviewId);
      if (!review) return;
      review.dueDate = addDaysToDateKey(review.dueDate, days);
      saveData();
      renderAll();
    }

    function deleteReview(reviewId) {
      appData.reviews = appData.reviews.filter(r => r.id !== reviewId);
      saveData();
      renderAll();
    }

    function deleteTopicEntirely(topicId) {
      if (confirm('Are you sure you want to delete this topic and all its scheduled repetitions?')) {
        appData.topics = appData.topics.filter(t => t.id !== topicId);
        appData.reviews = appData.reviews.filter(r => r.topicId !== topicId);
        saveData();
        renderAll();
      }
    }

    function updateStreak(todayKey) {
      if (!appData.lastStreakDate) {
        appData.streakCount = 1;
        appData.lastStreakDate = todayKey;
      } else {
        const last = parseDateKey(appData.lastStreakDate);
        const today = parseDateKey(todayKey);
        const diffDays = Math.round((today - last) / (1000 * 60 * 60 * 24));

        if (diffDays === 1) {
          appData.streakCount += 1;
          appData.lastStreakDate = todayKey;
        } else if (diffDays > 1) {
          appData.streakCount = 1;
          appData.lastStreakDate = todayKey;
        }
      }
    }

    /* ==========================================================================
       RENDERING: METRICS, DUE TODAY & CALENDAR
       ========================================================================== */
    function renderAll() {
      renderMetrics();
      renderTodayDue();
      renderCalendar();
      renderInspector(selectedInspectorDate);
      checkDailyNotifications();
    }

    function renderMetrics() {
      const today = getTodayKey();
      const dueCount = appData.reviews.filter(r => r.status === 'pending' && r.dueDate <= today).length;
      const completedCount = appData.reviews.filter(r => r.status === 'completed').length;

      document.getElementById('statDueToday').innerText = dueCount;
      document.getElementById('statTotalTopics').innerText = appData.topics.length;
      document.getElementById('statCompletedReviews').innerText = completedCount;
      document.getElementById('statStreak').innerText = `${appData.streakCount || 0} days 🔥`;

      // Top banner
      const banner = document.getElementById('dueNoticeBanner');
      const bannerText = document.getElementById('dueNoticeText');
      if (dueCount > 0) {
        banner.classList.remove('hidden');
        bannerText.innerText = `You have ${dueCount} spaced repetition review${dueCount > 1 ? 's' : ''} due today!`;
      } else {
        banner.classList.add('hidden');
      }

      // Update topics library modal badge & filters
      updateCategoryFilterOptions();
    }

    function renderTodayDue() {
      const today = getTodayKey();
      document.getElementById('todayHumanDate').innerText = formatHumanReadable(today);

      const dueReviews = appData.reviews.filter(r => r.status === 'pending' && r.dueDate <= today);
      const container = document.getElementById('dueListContainer');
      const emptyState = document.getElementById('emptyDueContainer');
      const badgeCount = document.getElementById('dueBadgeCount');

      badgeCount.innerText = `${dueReviews.length} due`;
      container.innerHTML = '';

      if (dueReviews.length === 0) {
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      dueReviews.forEach(rev => {
        const topic = appData.topics.find(t => t.id === rev.topicId) || { name: 'Unknown Topic', category: 'General', color: 'blue', notes: '' };
        const isOverdue = rev.dueDate < today;

        const card = document.createElement('div');
        card.className = "p-3.5 rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50/70 dark:bg-stone-800/40 flex flex-col gap-2.5 transition hover:shadow-sm";

        // Color badge classes
        const colorClasses = getColorTagClasses(topic.color);

        card.innerHTML = `
          <div class="flex items-start justify-between gap-2">
            <div class="flex-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-full ${colorClasses}">
                  ${topic.category}
                </span>
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-stone-200 dark:bg-stone-700 text-stone-700 dark:text-stone-300">
                  Stage ${rev.intervalIndex} (+${rev.intervalDays}d)
                </span>
                ${isOverdue ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300">Overdue</span>' : ''}
              </div>
              <h4 class="font-semibold text-sm mt-1 text-stone-900 dark:text-stone-100">${escapeHtml(topic.name)}</h4>
              ${topic.notes ? `<p class="text-xs text-stone-500 dark:text-stone-400 mt-1 line-clamp-2">${escapeHtml(topic.notes)}</p>` : ''}
            </div>
            
            <div class="flex items-center gap-1">
              <button onclick="postponeReview('${rev.id}', 1)" title="Postpone 1 day" class="p-1 rounded text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 hover:bg-stone-200 dark:hover:bg-stone-700">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </button>
            </div>
          </div>

          <!-- Difficulty Rating Buttons -->
          <div class="pt-2 border-t border-stone-200/60 dark:border-stone-700/60 flex items-center justify-between gap-1 flex-wrap">
            <span class="text-[11px] font-medium text-stone-400">Recall rating:</span>
            <div class="flex items-center gap-1.5">
              <button onclick="completeReviewWithRating('${rev.id}', 'again')" class="text-xs px-2 py-1 rounded bg-rose-100 hover:bg-rose-200 text-rose-700 dark:bg-rose-950 dark:hover:bg-rose-900 dark:text-rose-300 font-medium transition" title="Couldn't remember. Repeat tomorrow">
                Again
              </button>
              <button onclick="completeReviewWithRating('${rev.id}', 'hard')" class="text-xs px-2 py-1 rounded bg-amber-100 hover:bg-amber-200 text-amber-700 dark:bg-amber-950 dark:hover:bg-amber-900 dark:text-amber-300 font-medium transition" title="Remembered with difficulty">
                Hard
              </button>
              <button onclick="completeReviewWithRating('${rev.id}', 'good')" class="text-xs px-2.5 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-white font-medium shadow-sm transition" title="Normal recall">
                Good ✓
              </button>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function renderCalendar() {
      const year = currentCalendarDate.getFullYear();
      const month = currentCalendarDate.getMonth();
      const todayKey = getTodayKey();

      const monthName = currentCalendarDate.toLocaleString('default', { month: 'long' });
      document.getElementById('calendarMonthYear').innerText = `${monthName} ${year}`;

      const firstDayOfMonth = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const prevMonthDays = new Date(year, month, 0).getDate();

      const grid = document.getElementById('calendarGrid');
      grid.innerHTML = '';

      // Previous month placeholder days
      for (let i = firstDayOfMonth - 1; i >= 0; i--) {
        const dayNum = prevMonthDays - i;
        const cell = document.createElement('div');
        cell.className = 'h-16 sm:h-20 p-1 rounded-lg border border-transparent text-stone-300 dark:text-stone-700 select-none text-[11px]';
        cell.innerHTML = `<span>${dayNum}</span>`;
        grid.appendChild(cell);
      }

      // Current month days
      for (let day = 1; day <= daysInMonth; day++) {
        const dayDate = new Date(year, month, day);
        const dayKey = formatDateKey(dayDate);
        const isToday = dayKey === todayKey;
        const isSelected = dayKey === selectedInspectorDate;

        // Find reviews matching this date
        const dayReviews = appData.reviews.filter(r => r.dueDate === dayKey);
        const pendingCount = dayReviews.filter(r => r.status === 'pending').length;
        const completedCount = dayReviews.filter(r => r.status === 'completed').length;
        const isOverdue = dayKey < todayKey && pendingCount > 0;

        const cell = document.createElement('div');
        let baseClass = 'h-16 sm:h-20 p-1.5 rounded-xl border flex flex-col justify-between cursor-pointer transition relative ';
        
        if (isSelected) {
          baseClass += 'ring-2 ring-brand-500 bg-brand-50/50 dark:bg-brand-950/30 border-brand-300 dark:border-brand-800 ';
        } else if (isToday) {
          baseClass += 'bg-stone-100 dark:bg-stone-800/80 border-stone-300 dark:border-stone-700 ';
        } else {
          baseClass += 'bg-white dark:bg-stone-900/60 border-stone-200 dark:border-stone-800 hover:border-brand-300 dark:hover:border-stone-700 ';
        }

        cell.className = baseClass;
        cell.onclick = () => selectDate(dayKey);

        // Day header with badges
        let dotsHtml = '';
        if (dayReviews.length > 0) {
          dotsHtml = '<div class="flex items-center gap-1 mt-1 flex-wrap">';
          if (pendingCount > 0) {
            dotsHtml += `<span class="w-2 h-2 rounded-full ${isOverdue ? 'bg-rose-500' : 'bg-brand-500'}" title="${pendingCount} pending"></span>`;
          }
          if (completedCount > 0) {
            dotsHtml += `<span class="w-2 h-2 rounded-full bg-emerald-500" title="${completedCount} completed"></span>`;
          }
          dotsHtml += '</div>';
        }

        cell.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold ${isToday ? 'px-1.5 py-0.5 rounded-full bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900' : 'text-stone-700 dark:text-stone-300'}">${day}</span>
            ${dayReviews.length > 0 ? `<span class="text-[10px] font-mono ${pendingCount > 0 ? (isOverdue ? 'text-rose-600 dark:text-rose-400 font-bold' : 'text-brand-600 dark:text-brand-400 font-bold') : 'text-stone-400'}">${dayReviews.length}</span>` : ''}
          </div>
          ${dotsHtml}
        `;

        grid.appendChild(cell);
      }
    }

    function selectDate(dateKey) {
      selectedInspectorDate = dateKey;
      renderCalendar();
      renderInspector(dateKey);
      // Smooth scroll directly to the inspector if on mobile
      if (window.innerWidth < 1024) {
        document.getElementById('inspectorPanel').scrollIntoView({ behavior: 'smooth' });
      }
    }

    function renderInspector(dateKey) {
      document.getElementById('inspectorDateLabel').innerText = formatHumanReadable(dateKey);
      const list = document.getElementById('inspectorItemsList');
      list.innerHTML = '';

      const reviewsForDay = appData.reviews.filter(r => r.dueDate === dateKey);
      const today = getTodayKey();

      if (reviewsForDay.length === 0) {
        list.innerHTML = `
          <div class="py-8 text-center text-xs text-stone-400 dark:text-stone-500 flex flex-col items-center justify-center">
            <span class="text-2xl mb-1">🍃</span>
            <span>No repetitions scheduled on this date.</span>
            <button onclick="scheduleTopicForSelectedDate()" class="mt-2 text-brand-600 dark:text-brand-400 font-medium hover:underline">Schedule a study session here &rarr;</button>
          </div>
        `;
        return;
      }

      reviewsForDay.forEach(rev => {
        const topic = appData.topics.find(t => t.id === rev.topicId) || { name: 'Unknown', category: 'General', color: 'blue' };
        const isDone = rev.status === 'completed';
        const isOverdue = !isDone && rev.dueDate < today;

        const row = document.createElement('div');
        row.className = `p-3 rounded-xl border ${isDone ? 'border-emerald-200 dark:border-emerald-950 bg-emerald-50/30 dark:bg-emerald-950/20' : (isOverdue ? 'border-rose-200 dark:border-rose-950/60 bg-rose-50/20 dark:bg-rose-950/20' : 'border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-800/40')} flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs`;

        row.innerHTML = `
          <div class="flex items-start gap-2.5 overflow-hidden flex-1">
            <button onclick="toggleReviewDone('${rev.id}')" title="Mark completed" class="mt-0.5 w-4 h-4 rounded border flex items-center justify-center font-bold transition flex-shrink-0 ${isDone ? 'bg-emerald-500 border-emerald-500 text-white' : 'border-stone-300 dark:border-stone-600 hover:border-brand-500'}">
              ${isDone ? '✓' : ''}
            </button>
            <div class="truncate flex-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="font-semibold ${isDone ? 'line-through text-stone-400' : 'text-stone-800 dark:text-stone-200'}">${escapeHtml(topic.name)}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded font-medium ${getColorTagClasses(topic.color)}">${escapeHtml(topic.category)}</span>
              </div>
              <div class="text-[11px] text-stone-400 flex items-center gap-1.5 mt-0.5">
                <span>Stage ${rev.intervalIndex} (+${rev.intervalDays}d)</span>
                <span>•</span>
                <span>Status: <strong class="${isDone ? 'text-emerald-600 dark:text-emerald-400' : (isOverdue ? 'text-rose-500' : 'text-amber-600')}">${isDone ? 'Completed' : (isOverdue ? 'Overdue' : 'Due')}</strong></span>
                ${rev.rating ? `<span>• Recall: ${rev.rating}</span>` : ''}
              </div>
              ${topic.notes ? `<p class="text-[11px] text-stone-500 dark:text-stone-400 mt-1 italic">"${escapeHtml(topic.notes)}"</p>` : ''}
            </div>
          </div>

          <div class="flex items-center gap-1 self-end sm:self-center">
            ${!isDone ? `
              <button onclick="completeReviewWithRating('${rev.id}', 'good')" class="px-2 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-semibold">
                Mark Done
              </button>
            ` : ''}
            <button onclick="deleteReview('${rev.id}')" title="Remove this interval" class="p-1.5 text-stone-400 hover:text-rose-500 transition rounded hover:bg-stone-100 dark:hover:bg-stone-800">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        `;
        list.appendChild(row);
      });
    }

    /* ==========================================================================
       ALL TOPICS (MASTER DECK) LIBRARY IMPLEMENTATION
       ========================================================================== */
    function updateCategoryFilterOptions() {
      const select = document.getElementById('libraryCategoryFilter');
      if (!select) return;
      const currentVal = select.value;

      const categories = Array.from(new Set(appData.topics.map(t => t.category || 'General')));
      select.innerHTML = '<option value="ALL">All Subjects</option>';
      categories.forEach(cat => {
        const opt = document.createElement('option');
        opt.value = cat;
        opt.innerText = cat;
        select.appendChild(opt);
      });
      select.value = categories.includes(currentVal) ? currentVal : 'ALL';
    }

    function renderTopicsLibrary() {
      const query = (document.getElementById('librarySearchInput').value || '').toLowerCase().trim();
      const catFilter = document.getElementById('libraryCategoryFilter').value;
      const sortFilter = document.getElementById('librarySortFilter').value;
      const listContainer = document.getElementById('topicsLibraryList');
      const badge = document.getElementById('libraryTotalBadge');

      badge.innerText = `${appData.topics.length} Topic${appData.topics.length === 1 ? '' : 's'}`;
      listContainer.innerHTML = '';

      let filtered = [...appData.topics].filter(t => {
        const matchesQuery = !query || t.name.toLowerCase().includes(query) || (t.notes && t.notes.toLowerCase().includes(query)) || t.category.toLowerCase().includes(query);
        const matchesCat = catFilter === 'ALL' || t.category === catFilter;
        return matchesQuery && matchesCat;
      });

      // Sorting
      if (sortFilter === 'newest') {
        filtered.sort((a, b) => new Date(b.createdAt || b.startDate) - new Date(a.createdAt || a.startDate));
      } else if (sortFilter === 'oldest') {
        filtered.sort((a, b) => new Date(a.createdAt || a.startDate) - new Date(b.createdAt || b.startDate));
      } else if (sortFilter === 'alpha') {
        filtered.sort((a, b) => a.name.localeCompare(b.name));
      }

      if (filtered.length === 0) {
        listContainer.innerHTML = `
          <div class="py-12 text-center text-xs text-stone-400">
            No topics found matching your criteria.
          </div>
        `;
        return;
      }

      filtered.forEach(topic => {
        const topicReviews = appData.reviews.filter(r => r.topicId === topic.id);
        const completedReviews = topicReviews.filter(r => r.status === 'completed');
        const nextPendingReview = topicReviews.filter(r => r.status === 'pending').sort((a, b) => a.dueDate.localeCompare(b.dueDate))[0];
        const progressPercent = topicReviews.length > 0 ? Math.round((completedReviews.length / topicReviews.length) * 100) : 0;

        const card = document.createElement('div');
        card.className = "p-4 rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50/60 dark:bg-stone-800/40 hover:bg-white dark:hover:bg-stone-800 transition flex flex-col gap-2.5";

        card.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full ${getColorTagClasses(topic.color)}">${escapeHtml(topic.category)}</span>
                <span class="text-[11px] text-stone-400">Learned: ${topic.startDate}</span>
                <span class="text-[11px] text-stone-400">• Preset: ${topic.preset || 'standard'}</span>
              </div>
              <h4 class="font-bold text-sm sm:text-base text-stone-900 dark:text-stone-100 mt-1">${escapeHtml(topic.name)}</h4>
              ${topic.notes ? `<p class="text-xs text-stone-500 dark:text-stone-400 mt-1">${escapeHtml(topic.notes)}</p>` : ''}
            </div>

            <div class="flex items-center gap-1.5">
              <button onclick="promptEditTopic('${topic.id}')" title="Edit topic notes" class="p-1.5 text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 rounded hover:bg-stone-200 dark:hover:bg-stone-700 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              </button>
              <button onclick="deleteTopicEntirely('${topic.id}')" title="Delete topic and reviews" class="p-1.5 text-stone-400 hover:text-rose-500 rounded hover:bg-rose-50 dark:hover:bg-rose-950/50 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>
          </div>

          <!-- Progress Bar & Next Due -->
          <div class="pt-2 border-t border-stone-100 dark:border-stone-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-2 flex-1">
              <div class="w-full sm:w-32 bg-stone-200 dark:bg-stone-700 h-1.5 rounded-full overflow-hidden">
                <div class="bg-brand-500 h-full rounded-full" style="width: ${progressPercent}%"></div>
              </div>
              <span class="text-[11px] font-mono text-stone-500">${completedReviews.length}/${topicReviews.length} (${progressPercent}%)</span>
            </div>

            <div class="text-[11px] text-stone-500 dark:text-stone-400 flex items-center gap-1.5">
              ${nextPendingReview 
                ? `<span>Next repetition: <strong class="text-stone-800 dark:text-stone-200">${nextPendingReview.dueDate}</strong> (Stage ${nextPendingReview.intervalIndex})</span>`
                : `<span class="text-emerald-600 dark:text-emerald-400 font-semibold">All intervals mastered! 🎉</span>`
              }
            </div>
          </div>
        `;
        listContainer.appendChild(card);
      });
    }

    function promptEditTopic(topicId) {
      const topic = appData.topics.find(t => t.id === topicId);
      if (!topic) return;

      const newName = prompt('Edit Topic Name:', topic.name);
      if (newName === null) return;
      const newCategory = prompt('Edit Subject / Category:', topic.category || '');
      const newNotes = prompt('Edit Key Notes / Formulas:', topic.notes || '');

      if (newName.trim()) topic.name = newName.trim();
      if (newCategory !== null) topic.category = newCategory.trim() || 'General';
      if (newNotes !== null) topic.notes = newNotes.trim();

      saveData();
      renderAll();
      renderTopicsLibrary();
    }

    function toggleReviewDone(reviewId) {
      const review = appData.reviews.find(r => r.id === reviewId);
      if (!review) return;
      if (review.status === 'completed') {
        review.status = 'pending';
        review.completedAt = null;
      } else {
        review.status = 'completed';
        review.completedAt = new Date().toISOString();
        playChime('success');
      }
      saveData();
      renderAll();
    }

    function scheduleTopicForSelectedDate() {
      document.getElementById('topicStartDateInput').value = selectedInspectorDate;
      openModal('addTopicModal');
    }

    /* ==========================================================================
       TOPIC CREATION & MODAL CONTROLS
       ========================================================================== */
    function handleCreateTopic(e) {
      e.preventDefault();
      const name = document.getElementById('topicNameInput').value.trim();
      const category = document.getElementById('topicCategoryInput').value.trim();
      const startDate = document.getElementById('topicStartDateInput').value;
      const preset = document.getElementById('topicIntervalPreset').value;
      const notes = document.getElementById('topicNotesInput').value.trim();
      
      const colorRadio = document.querySelector('input[name="colorTag"]:checked');
      const color = colorRadio ? colorRadio.value : 'blue';

      if (!name || !startDate) return;

      scheduleTopic(name, category, color, startDate, preset, notes);
      closeModal('addTopicModal');
      e.target.reset();
      document.getElementById('topicStartDateInput').value = getTodayKey();
    }

    function openModal(id) {
      const el = document.getElementById(id);
      if (el) {
        el.classList.remove('hidden');
        el.classList.add('flex');
        if (id === 'topicsLibraryModal') {
          renderTopicsLibrary();
        }
      }
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) {
        el.classList.add('hidden');
        el.classList.remove('flex');
      }
    }

    function changeMonth(delta) {
      currentCalendarDate.setMonth(currentCalendarDate.getMonth() + delta);
      renderCalendar();
    }

    function goToCurrentMonth() {
      currentCalendarDate = new Date();
      selectedInspectorDate = getTodayKey();
      renderCalendar();
      renderInspector(selectedInspectorDate);
    }

    function scrollToDueSection() {
      document.getElementById('dueSection').scrollIntoView({ behavior: 'smooth' });
    }

    function getColorTagClasses(color) {
      switch(color) {
        case 'emerald': return 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
        case 'purple': return 'bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300';
        case 'amber': return 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
        case 'rose': return 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300';
        default: return 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    /* ==========================================================================
       NOTIFICATIONS API INTEGRATION
       ========================================================================== */
    function toggleNotifications() {
      updateNotificationStatusUI();
      openModal('notifySettingsModal');
    }

    function updateNotificationStatusUI() {
      const statusLabel = document.getElementById('notificationStatusText');
      const reqBtn = document.getElementById('reqPermBtn');
      const savedTime = localStorage.getItem(NOTIFY_TIME_KEY) || '09:00';
      document.getElementById('dailyReminderTime').value = savedTime;

      if (!('Notification' in window)) {
        statusLabel.innerText = 'Not supported in this browser';
        reqBtn.classList.add('hidden');
        return;
      }

      if (Notification.permission === 'granted') {
        statusLabel.innerText = 'Status: Active / Allowed ✓';
        reqBtn.innerText = 'Granted';
        reqBtn.disabled = true;
        reqBtn.classList.replace('bg-brand-600', 'bg-emerald-600');
      } else if (Notification.permission === 'denied') {
        statusLabel.innerText = 'Status: Blocked in browser settings';
        reqBtn.innerText = 'Blocked';
        reqBtn.disabled = true;
      } else {
        statusLabel.innerText = 'Status: Not enabled yet';
        reqBtn.innerText = 'Enable';
        reqBtn.disabled = false;
      }
    }

    async function requestNotificationPermission() {
      if (!('Notification' in window)) return;
      const perm = await Notification.requestPermission();
      updateNotificationStatusUI();
      if (perm === 'granted') {
        new Notification('Memorise Spaced Repetition', {
          body: 'Study reminders enabled! We will alert you when intervals are due.',
          icon: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">🧠</text></svg>'
        });
      }
    }

    function saveReminderTime() {
      const timeVal = document.getElementById('dailyReminderTime').value;
      localStorage.setItem(NOTIFY_TIME_KEY, timeVal);
      alert(`Daily reminder time saved: ${timeVal}`);
      closeModal('notifySettingsModal');
    }

    function testNotificationChime() {
      playChime('bell');
      if ('Notification' in window && Notification.permission === 'granted') {
        new Notification('Study Reminder Test 🧠', {
          body: 'Your spaced repetition session is ready!',
          icon: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">🧠</text></svg>'
        });
      }
    }

    function checkDailyNotifications() {
      if (!('Notification' in window) || Notification.permission !== 'granted') return;

      const now = new Date();
      const currentTimeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      const savedTime = localStorage.getItem(NOTIFY_TIME_KEY) || '09:00';
      const lastNotifiedKey = 'last_notified_' + getTodayKey();

      if (currentTimeStr === savedTime && !sessionStorage.getItem(lastNotifiedKey)) {
        const today = getTodayKey();
        const dueCount = appData.reviews.filter(r => r.status === 'pending' && r.dueDate <= today).length;
        if (dueCount > 0) {
          playChime('bell');
          new Notification('Study Session Due! 🎯', {
            body: `You have ${dueCount} spaced repetition topics scheduled for review today.`,
            icon: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">🧠</text></svg>'
          });
          sessionStorage.setItem(lastNotifiedKey, 'true');
        }
      }
    }

    // Periodic check every 60 seconds
    setInterval(checkDailyNotifications, 60000);

    /* ==========================================================================
       LOCALSTORAGE & IMPORT/EXPORT LOGIC
       ========================================================================== */
    function saveData() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
    }

    function loadData() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        try {
          appData = JSON.parse(raw);
        } catch (e) {
          console.error('Failed to parse study data', e);
          loadSampleData();
        }
      } else {
        loadSampleData();
      }
    }

    function exportDataJSON() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `memorise_backup_${getTodayKey()}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function importDataJSON(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const parsed = JSON.parse(e.target.result);
          if (parsed.topics && parsed.reviews) {
            appData = parsed;
            saveData();
            renderAll();
            closeModal('backupModal');
            alert('Backup successfully imported!');
          } else {
            alert('Invalid backup file format.');
          }
        } catch (err) {
          alert('Could not parse JSON backup file.');
        }
      };
      reader.readAsText(file);
    }

